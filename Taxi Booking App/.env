FLASK_ENV=development
FLASK_APP=app.main:create_app
FLASK_SECRET_KEY=your_existing_flask_secret_key121718
SECRET_KEY=${FLASK_SECRET_KEY}  # Uses the same key as FLASK_SECRET_KEY
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Mapbox settings
MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoic3V1ZGhpIiwiYSI6ImNtOWs0cW9vMDBpdmwybXM2c21ramNmZTQifQ.xsTF7EaOpYKwX4VaVMNgCQ

# Database settings
